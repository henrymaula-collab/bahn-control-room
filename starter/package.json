    "demo:reset": "tsx scripts/demo-reset.ts",
    "smoke:cr": "tsx scripts/smoke-control-room.ts",
    "test:cr": "node --import tsx --test --test-concurrency=1 lib/control-room/*.test.ts",
    "agent": "tsx scripts/agent.ts",

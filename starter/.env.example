# Copy to .env (cp .env.example .env). Everything here runs without any API key.
# Keys go in .env.local, which git ignores (see the README, "Switching on the real providers").

# Docker Compose reads this file too. Its own project name keeps these containers
# and volumes apart from any other "starter" project on this computer.
COMPOSE_PROJECT_NAME=bahn-control-room

# Postgres and the local attachment store from compose.yaml. If you change a port
# there (docs/running.md), change it here too.
DATABASE_URL=postgres://controlroom:controlroom@localhost:5438/controlroom
S3_ENDPOINT=http://127.0.0.1:9009
S3_ACCESS_KEY_ID=controlroom
S3_SECRET_ACCESS_KEY=controlroom-local-only
S3_BUCKET=controlroom-attachments

# Who answers. mock = scripted chat answers, replay = the agent's recorded runs.
# With keys: CR_CHAT_PROVIDER=api; CR_AGENT_PROVIDER=api or claude-code.
CR_CHAT_PROVIDER=mock
CR_AGENT_PROVIDER=replay

# 300 made-up quiet orders on the Overview map, as in the demo. 0 shows only the 100 dataset orders.
CR_SCALE=300
